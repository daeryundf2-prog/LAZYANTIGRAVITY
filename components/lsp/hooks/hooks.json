{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "^(write_to_file|WriteToFile|write_file|WriteFile|apply_patch|Write|Edit|MultiEdit|multi_edit|write|edit|multiedit|search_replace|SearchReplace|str_replace|StrReplace|replace_file_content|ReplaceFileContent)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook post-tool-use",
						"timeout": 60,
						"statusMessage": "LazyAntigravity(0.2.0): Checking LSP Diagnostics"
					}
				]
			}
		],
		"PostCompact": [
			{
				"matcher": "manual|auto",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook post-compact",
						"timeout": 5,
						"statusMessage": "LazyAntigravity(0.2.0): Resetting LSP Diagnostics Cache"
					}
				]
			}
		]
	}
}
