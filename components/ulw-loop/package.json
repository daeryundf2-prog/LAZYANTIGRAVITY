{
	"name": "@lazyantigravity/ulw-loop",
	"version": "0.1.0",
	"description": "Antigravity plugin: durable repo-native multi-goal orchestration with embedded success criteria and observable evidence audit.",
	"type": "module",
	"packageManager": "npm@11.12.1",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"bin": {
		"lazyantigravity": "./dist/cli.js",
		"omo": "./dist/cli.js"
	},
	"files": [
		"dist",
		"hooks",
		"skills",
		"LICENSE",
		"NOTICE",
		"README.md",
		"CHANGELOG.md"
	],
	"keywords": [
		"antigravity",
		"antigravity-plugin",
		"ulw-loop",
		"goal-mode",
		"orchestration",
		"evidence",
		"typescript"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "tsc --noEmit && biome check . && npm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@types/node": "^25.7.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	},
	"peerDependencies": {
		"@opencode-ai/sdk": "*"
	},
	"peerDependenciesMeta": {
		"@opencode-ai/sdk": {
			"optional": true
		}
	},
	"homepage": "https://github.com/daeryundf2-prog/LAZYANTIGRAVITY",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/daeryundf2-prog/LAZYANTIGRAVITY.git"
	},
	"bugs": {
		"url": "https://github.com/daeryundf2-prog/LAZYANTIGRAVITY/issues"
	}
}
