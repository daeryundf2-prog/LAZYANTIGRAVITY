{
	"name": "@lazyantigravity/telemetry",
	"version": "0.1.0",
	"description": "Antigravity plugin component that emits lazyantigravity opt-in anonymous daily-active telemetry on SessionStart.",
	"type": "module",
	"packageManager": "npm@11.12.1",
	"license": "MIT",
	"homepage": "https://github.com/daeryundf2-prog/LAZYANTIGRAVITY",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/daeryundf2-prog/LAZYANTIGRAVITY.git"
	},
	"bugs": {
		"url": "https://github.com/daeryundf2-prog/LAZYANTIGRAVITY/issues"
	},
	"keywords": [
		"antigravity",
		"antigravity-plugin",
		"omo",
		"telemetry",
		"posthog",
		"hooks",
		"daily-active"
	],
	"bin": {
		"lazyantigravity-telemetry": "./dist/cli.js",
		"omo-telemetry": "./dist/cli.js"
	},
	"files": [
		"dist",
		"hooks",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "tsc --noEmit && biome check . && npm run build"
	},
	"dependencies": {
		"posthog-node": "^5.34.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@types/node": "^25.7.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
