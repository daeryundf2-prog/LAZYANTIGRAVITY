{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazyantigravity.local/schemas/evidence.schema.json",
  "title": "LAZYANTIGRAVITY evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "surface",
    "capability",
    "snapshotKind",
    "subjectFiles",
    "subjectFingerprint",
    "workspaceFingerprint",
    "status",
    "command",
    "validatorRuntime",
    "publishedRuntime",
    "os",
    "startedAt",
    "finishedAt",
    "exitCode",
    "assertionIds",
    "artifactHashes"
  ],
  "properties": {
    "task": { "type": "string", "minLength": 1 },
    "surface": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "snapshotKind": { "type": "string", "enum": ["baseline", "task-red", "final"] },
    "subjectFiles": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(?!/|[A-Za-z]:|//|.*(?:^|/)\\.\\.?(?:/|$)).+" },
      "uniqueItems": true
    },
    "subjectFingerprint": { "$ref": "#/$defs/sha256" },
    "workspaceFingerprint": { "$ref": "#/$defs/sha256" },
    "status": { "type": "string", "enum": ["passed", "failed", "skipped", "unavailable", "stale"] },
    "verificationLevel": { "$ref": "#/$defs/verificationLevel" },
    "liveStatus": { "$ref": "#/$defs/liveStatus" },
    "command": { "type": "string", "minLength": 1 },
    "validatorRuntime": { "$ref": "#/$defs/runtime" },
    "publishedRuntime": { "$ref": "#/$defs/runtime" },
    "os": {
      "type": "object",
      "additionalProperties": true,
      "required": ["platform", "arch"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "exitCode": { "type": "integer" },
    "assertionIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "artifactHashes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "executable"],
      "properties": {
        "version": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+" },
        "executable": { "type": "string", "minLength": 1 },
        "executableSha256": { "$ref": "#/$defs/sha256" },
        "executablePathStringSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "verificationLevel": {
      "type": "string",
      "enum": ["unverified", "contract-tested", "staged-process-verified", "live-verified", "experimental", "unsupported"]
    },
    "liveStatus": {
      "type": "string",
      "enum": ["unavailable", "skipped", "failed", "passed", "stale"]
    }
  }
}
