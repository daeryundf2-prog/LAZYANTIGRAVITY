{
  "$schema": "https://lazyantigravity.local/schemas/verified-gates.schema.json",
  "schemaVersion": 1,
  "policyId": "lazyantigravity.todo8.verified-quality-gates",
  "automaticGates": [
    {
      "id": "bounded-context",
      "kind": "bounded_context",
      "surface": "PreInvocation context injection",
      "status": "verified",
      "description": "Injects only bounded, provenance-labelled OMO continuation context."
    },
    {
      "id": "bounded-continuation",
      "kind": "bounded_continuation",
      "surface": "Stop continuation",
      "status": "verified",
      "description": "Continues only an exact active Boulder work item with bounded retry state."
    }
  ],
  "onDemandGates": [
    {
      "id": "lsp-error-verification",
      "kind": "lsp_diagnostics",
      "status": "verified",
      "description": "After editing code, verify each changed source file on demand with local language-server diagnostics.",
      "invocation": {
        "serverId": "lsp",
        "tool": "diagnostics",
        "arguments": {
          "filePath": "<absolute changed file>",
          "severity": "error"
        }
      },
      "messages": {
        "clean": "LSP verification: clean (<file>)",
        "diagnostics": "LSP verification: <N> error(s) (<file>)",
        "unavailable": "LSP verification unavailable: <reason>"
      },
      "fixtures": {
        "clean": "test/fixtures/lsp/clean.json",
        "diagnostics": "test/fixtures/lsp/diagnostics.json",
        "unavailable": "test/fixtures/lsp/unavailable.json"
      },
      "locationLimit": 5
    }
  ],
  "experimentalGates": [
    {
      "id": "comment-preservation",
      "kind": "comment_checker",
      "status": "experimental",
      "description": "Comment-preservation feedback is experimental and must not be represented as a verified automatic diagnostic gate."
    },
    {
      "id": "file-targeted-diagnostics",
      "kind": "file_targeted_diagnostics",
      "status": "experimental",
      "description": "File-targeted diagnostics outside the on-demand LSP invocation are experimental and must not be represented as automatic clean verification."
    }
  ],
  "unsupportedAutomaticDiagnostics": {
    "eventPayloadKinds": ["post-tool hook payload", "post-invocation hook payload", "fabricated Codex-shaped payload"],
    "policy": "Unsupported automatic diagnostic payloads are rejected; they must not produce clean verification."
  },
  "publishingWorkflows": [
    "skill-aliases/ulw/SKILL.md",
    "components/ulw-loop/skills/ulw-loop/SKILL.md",
    "skill-aliases/start-work/SKILL.md",
    "skill-aliases/review-work/SKILL.md"
  ]
}
