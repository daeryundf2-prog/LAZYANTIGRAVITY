{
	"mcpServers": {
		"grep_app": {
			"url": "https://mcp.grep.app"
		},
		"context7": {
			"url": "https://mcp.context7.com/mcp"
		},
		"git_bash": {
			"command": "node",
			"args": [
				"./components/git-bash-mcp/dist/cli.js",
				"mcp"
			],
			"cwd": "."
		},
		"lsp": {
			"command": "node",
			"args": [
				"./components/lsp-daemon/dist/cli.js",
				"mcp"
			],
			"cwd": "."
		}
	}
}
