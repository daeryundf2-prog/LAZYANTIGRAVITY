{
	"name": "lazyantigravity",
	"version": "0.6.0",
	"description": "Aggregated Antigravity plugin root for LazyAntigravity components (Gemini 3.7 Flash default).",
	"type": "module",
	"packageManager": "npm@11.12.1",
	"license": "MIT",
	"private": true,
	"engines": {
		"node": ">=20"
	},
	"files": [
		"shared-skills/package.json",
		"shared-skills/index.mjs",
		"shared-skills/skills"
	],
	"workspaces": [
		"components/comment-checker",
		"components/git-bash",
		"components/rules",
		"components/lsp",
		"components/telemetry",
		"components/start-work-continuation",
		"components/ulw-loop",
		"components/ultrawork",
		"components/quick-lane",
		"components/memory",
		"components/adaptive-reasoning",
		"components/daemon-bridge",
		"components/ast-index",
		"components/session-tree",
		"components/active-learning"
	],
	"dependencies": {
		"@iarna/toml": "^2.2.5",
		"@lazyantigravity/shared-skills": "file:./shared-skills",
		"@lazyantigravity/sync-skills": "file:./src/packages/sync-skills"
	},
	"scripts": {
		"build": "node scripts/sync-mcp-config.mjs && node scripts/sync-hook-status-messages.mjs && node scripts/build-bundled-mcp-runtimes.mjs && node scripts/sync-skills.mjs && node plugins/scripts/sync-telemetry-component.mjs && node scripts/build-components.mjs && node scripts/materialize-shared-skills.mjs --pack && node scripts/sync-omo-mirror.mjs",
		"check": "npm run build && npm run verify:hook-policies && npm test && npm run test:components",
		"doctor": "node scripts/lazyantigravity-doctor.mjs",
		"evidence:map": "node scripts/lazyantigravity-evidence-map.mjs",
		"hooks:report": "node scripts/lazyantigravity-hooks-report.mjs",
		"icons:report": "node scripts/lazyantigravity-oss-icons-report.mjs",
		"mcp:status": "node scripts/lazyantigravity-mcp-status.mjs",
		"prepack": "node scripts/materialize-shared-skills.mjs --pack",
		"postpack": "node scripts/materialize-shared-skills.mjs --restore",
		"provenance": "node scripts/lazyantigravity-provenance.mjs",
		"sync:omo": "node scripts/sync-omo-mirror.mjs",
		"sync:skills": "node scripts/sync-skills.mjs",
		"test": "node --test test/*.test.mjs && node --test components/daemon-bridge/test/daemon-bridge.test.mjs && npx vitest --run components/ulw-loop/test/checkpoint.test.ts",
		"verify:hook-policies": "node scripts/verify-hook-policies.mjs",
		"probe:model-capabilities": "node scripts/model-capability-probe.mjs",
		"verify:reproducible": "node scripts/verify-dist-sync.mjs",
		"test:components": "node scripts/run-component-tests.mjs"
	}
}
