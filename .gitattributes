# Normalize line endings: LF everywhere except Windows-native scripts.
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.jsonl text eol=lf
*.tmpl text eol=lf
*.go text eol=lf
*.ts text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Contract files are pinned by SHA-256 — git must not alter a single byte.
# (last rule wins, so this stays below the wildcard rules)
contracts/** -text
