{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/rules/dist/cli.js\" hook session-start",
						"timeout": 10,
						"statusMessage": "(OmO) Loading Project Rules"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/hook-runner.mjs\" BACKGROUND none none node \"${PLUGIN_ROOT}/components/telemetry/dist/cli.js\" hook session-start",
						"timeout": 1,
						"statusMessage": "(OmO) Recording Session Telemetry",
						"failurePolicy": "BACKGROUND"
					}
				]
			},
			{
				"matcher": "^startup$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/hook-runner.mjs\" BACKGROUND none none node \"${PLUGIN_ROOT}/scripts/auto-update.mjs\" hook session-start",
						"timeout": 1,
						"statusMessage": "(OmO) Checking Auto Update",
						"failurePolicy": "BACKGROUND"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/check-prompt-density.mjs\"",
						"timeout": 5,
						"statusMessage": "(OmO) Analyzing Prompt Density"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/prompt-amplifier.mjs\"",
						"timeout": 5,
						"statusMessage": "(OmO) Amplifying Prompt Constraints"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/rules/dist/cli.js\" hook user-prompt-submit",
						"timeout": 10,
						"statusMessage": "(OmO) Loading Project Rules"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/ultrawork/dist/cli.js\" hook user-prompt-submit",
						"timeout": 5,
						"statusMessage": "(OmO) Checking Ultrawork Trigger"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/ulw-loop/dist/cli.js\" hook user-prompt-submit",
						"timeout": 10,
						"statusMessage": "(OmO) Checking Ulw-Loop Steering"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "^Bash$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/git-bash/dist/cli.js\" hook pre-tool-use",
						"timeout": 5,
						"statusMessage": "(OmO) Recommending Git Bash MCP"
					}
				]
			},
			{
				"matcher": "^create_goal$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/hook-runner.mjs\" FAIL_SAFE eyJob29rU3BlY2lmaWNPdXRwdXQiOnsiaG9va0V2ZW50TmFtZSI6IlByZVRvb2xVc2UiLCJwZXJtaXNzaW9uRGVjaXNpb24iOiJkZW55IiwicGVybWlzc2lvbkRlY2lzaW9uUmVhc29uIjoiRkFJTF9TQUZFIGRlZmF1bHQgYmxvY2siLCJhZGRpdGlvbmFsQ29udGV4dCI6Ikhvb2sgcnVubmVyIGNyYXNoZWQsIHVzaW5nIHNhZmUgZmFsbGJhY2suIn19 none node \"${PLUGIN_ROOT}/components/ulw-loop/dist/cli.js\" hook pre-tool-use",
						"timeout": 5,
						"statusMessage": "(OmO) Enforcing Unlimited Goal Budget",
						"failurePolicy": "FAIL_SAFE",
						"fallbackPayload": {
							"hookSpecificOutput": {
								"hookEventName": "PreToolUse",
								"permissionDecision": "deny",
								"permissionDecisionReason": "FAIL_SAFE default block",
								"additionalContext": "Hook runner crashed, using safe fallback."
							}
						}
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "^(apply_patch|write|Write|edit|Edit|multi_edit|multiedit|MultiEdit)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/comment-checker/dist/cli.js\" hook post-tool-use",
						"timeout": 30,
						"statusMessage": "(OmO) Checking Comments"
					},
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/lsp/dist/cli.js\" hook post-tool-use",
						"timeout": 60,
						"statusMessage": "(OmO) Checking LSP Diagnostics"
					}
				]
			},
			{
				"matcher": "^apply_patch$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/rules/dist/cli.js\" hook post-tool-use",
						"timeout": 10,
						"statusMessage": "(OmO) Matching Project Rules"
					}
				]
			}
		],
		"PostCompact": [
			{
				"matcher": "manual|auto",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/git-bash/dist/cli.js\" hook post-compact",
						"timeout": 5,
						"statusMessage": "(OmO) Resetting Git Bash MCP Reminder"
					}
				]
			},
			{
				"matcher": "manual|auto",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/rules/dist/cli.js\" hook post-compact",
						"timeout": 10,
						"statusMessage": "(OmO) Resetting Project Rule Cache"
					}
				]
			},
			{
				"matcher": "manual|auto",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/lsp/dist/cli.js\" hook post-compact",
						"timeout": 5,
						"statusMessage": "(OmO) Resetting LSP Diagnostics Cache"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/start-work-continuation/dist/cli.js\" hook stop",
						"timeout": 10,
						"statusMessage": "(OmO) Checking Start-Work Continuation"
					}
				]
			}
		],
		"SubagentStop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/start-work-continuation/dist/cli.js\" hook subagent-stop",
						"timeout": 10,
						"statusMessage": "(OmO) Checking Start-Work Continuation"
					}
				]
			}
		]
	}
}
