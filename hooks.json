{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/rules/dist/cli.js\" hook session-start",
						"timeout": 5,
						"statusMessage": "LazyAntigravity(0.7.0): Loading Project Rules"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/memory/dist/cli.js\" hook session-start",
						"timeout": 3,
						"statusMessage": "LazyAntigravity(0.7.0): Loading Active Memory"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/daemon-bridge/dist/cli.js\" hook session-start",
						"timeout": 3,
						"statusMessage": "LazyAntigravity(0.7.0): Initializing Ipc Daemon Bridge"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/ast-index/dist/cli.js\" hook session-start",
						"timeout": 5,
						"statusMessage": "LazyAntigravity(0.7.0): Pre-Indexing Ast Call Graph"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/hook-runner.mjs\" FAIL_OPEN none none node \"${PLUGIN_ROOT}/components/telemetry/dist/cli.js\" hook session-start",
						"timeout": 3,
						"statusMessage": "LazyAntigravity(0.7.0): Recording Session Telemetry",
						"failurePolicy": "FAIL_OPEN"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/rules/dist/cli.js\" hook user-prompt-submit",
						"timeout": 3,
						"statusMessage": "LazyAntigravity(0.7.0): Loading Project Rules"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/quick-lane/dist/cli.js\" hook user-prompt-submit",
						"timeout": 2,
						"statusMessage": "LazyAntigravity(0.7.0): Checking Quick-Lane Trigger"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/adaptive-reasoning/dist/cli.js\" hook user-prompt-submit",
						"timeout": 2,
						"statusMessage": "LazyAntigravity(0.7.0): Scaling Adaptive Reasoning"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/ultrawork/dist/cli.js\" hook user-prompt-submit",
						"timeout": 2,
						"statusMessage": "LazyAntigravity(0.7.0): Checking Ultrawork Trigger"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/ulw-loop/dist/cli.js\" hook user-prompt-submit",
						"timeout": 3,
						"statusMessage": "LazyAntigravity(0.7.0): Checking Ulw-Loop Steering"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "^(Bash|bash|shell|Shell|run_command|RunCommand|terminal|Terminal|execute|Execute)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/git-bash/dist/cli.js\" hook pre-tool-use",
						"timeout": 2,
						"statusMessage": "LazyAntigravity(0.7.0): Recommending Git Bash Mcp"
					}
				]
			},
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/hook-runner.mjs\" FAIL_OPEN none none node \"${PLUGIN_ROOT}/scripts/awt-guard.mjs\"",
						"timeout": 2,
						"statusMessage": "LazyAntigravity(0.7.0): Verifying Awt Trajectory Integrity",
						"failurePolicy": "FAIL_OPEN"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "^(apply_patch|write|Write|edit|Edit|multi_edit|multiedit|MultiEdit|search_replace|SearchReplace|str_replace|StrReplace|replace_file_content|ReplaceFileContent)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/comment-checker/dist/cli.js\" hook post-tool-use",
						"timeout": 10,
						"statusMessage": "LazyAntigravity(0.7.0): Checking Comments"
					},
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/lsp/dist/cli.js\" hook post-tool-use",
						"timeout": 10,
						"statusMessage": "LazyAntigravity(0.7.0): Checking LSP Diagnostics"
					},
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/markdown_structure_guard.mjs\"",
						"timeout": 5,
						"statusMessage": "LazyAntigravity: Markdown structure guard (스트리핑/빈 링크/표 불일치)",
						"failurePolicy": "FAIL_CLOSED"
					}
				]
			},
			{
				"matcher": "^(apply_patch|search_replace|SearchReplace|str_replace|StrReplace|replace_file_content|ReplaceFileContent)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/rules/dist/cli.js\" hook post-tool-use",
						"timeout": 3,
						"statusMessage": "LazyAntigravity(0.7.0): Matching Project Rules"
					}
				]
			}
		],
		"PostCompact": [
			{
				"matcher": "manual|auto",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/git-bash/dist/cli.js\" hook post-compact",
						"timeout": 2,
						"statusMessage": "LazyAntigravity(0.7.0): Resetting Git Bash Mcp Reminder"
					}
				]
			},
			{
				"matcher": "manual|auto",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/rules/dist/cli.js\" hook post-compact",
						"timeout": 3,
						"statusMessage": "LazyAntigravity(0.7.0): Resetting Project Rule Cache"
					}
				]
			},
			{
				"matcher": "manual|auto",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/lsp/dist/cli.js\" hook post-compact",
						"timeout": 2,
						"statusMessage": "LazyAntigravity(0.7.0): Resetting LSP Diagnostics Cache"
					}
				]
			},
			{
				"matcher": "manual|auto",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/ulw-loop/dist/cli.js\" hook post-compact",
						"timeout": 3,
						"statusMessage": "LazyAntigravity(0.7.0): Restoring Ulw-Loop Context"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/hook-runner.mjs\" FAIL_CLOSED none none node \"${PLUGIN_ROOT}/scripts/ulw-readiness.mjs\"",
						"timeout": 2,
						"statusMessage": "LazyAntigravity(0.7.0): Checking Ulw Readiness",
						"failurePolicy": "FAIL_CLOSED"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/start-work-continuation/dist/cli.js\" hook stop",
						"timeout": 3,
						"statusMessage": "LazyAntigravity(0.7.0): Checking Start-Work Continuation"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/daemon-bridge/dist/cli.js\" hook stop",
						"timeout": 2,
						"statusMessage": "LazyAntigravity(0.7.0): Checking Ipc Daemon State"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/session-tree/dist/cli.js\" hook stop",
						"timeout": 2,
						"statusMessage": "LazyAntigravity(0.7.0): Checkpointing Session Tree"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/active-learning/dist/cli.js\" hook stop",
						"timeout": 2,
						"statusMessage": "LazyAntigravity(0.7.0): Analyzing Failure Patterns (read-Only)"
					}
				]
			},
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/hook-runner.mjs\" FAIL_OPEN none none node \"${PLUGIN_ROOT}/scripts/stop_claim_guard.mjs\"",
						"timeout": 5,
						"statusMessage": "LazyAntigravity: Stop claim guard (무근거 완료 선언 차단)"
					}
				]
			}
		],
		"SubagentStop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/start-work-continuation/dist/cli.js\" hook subagent-stop",
						"timeout": 3,
						"statusMessage": "LazyAntigravity(0.7.0): Checking Start-Work Continuation"
					}
				]
			},
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/hook-runner.mjs\" FAIL_OPEN none none node \"${PLUGIN_ROOT}/scripts/stop_claim_guard.mjs\"",
						"timeout": 5,
						"statusMessage": "LazyAntigravity: Stop claim guard (무근거 완료 선언 차단)"
					}
				]
			}
		]
	}
}
