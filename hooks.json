{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/rules/dist/cli.js\" hook session-start",
						"timeout": 10,
						"statusMessage": "LazyAntigravity(0.2.2): Loading Project Rules"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/hook-runner.mjs\" FAIL_OPEN none none node \"${PLUGIN_ROOT}/components/telemetry/dist/cli.js\" hook session-start",
						"timeout": 5,
						"statusMessage": "LazyAntigravity(0.2.2): Recording Session Telemetry",
						"failurePolicy": "FAIL_OPEN"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/rules/dist/cli.js\" hook user-prompt-submit",
						"timeout": 10,
						"statusMessage": "LazyAntigravity(0.2.2): Loading Project Rules"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/ultrawork/dist/cli.js\" hook user-prompt-submit",
						"timeout": 5,
						"statusMessage": "LazyAntigravity(0.2.2): Checking Ultrawork Trigger"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/ulw-loop/dist/cli.js\" hook user-prompt-submit",
						"timeout": 10,
						"statusMessage": "LazyAntigravity(0.2.2): Checking Ulw-Loop Steering"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "^Bash$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/git-bash/dist/cli.js\" hook pre-tool-use",
						"timeout": 5,
						"statusMessage": "LazyAntigravity(0.2.2): Recommending Git Bash Mcp"
					}
				]
			},
			{
				"matcher": "^create_goal$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/hook-runner.mjs\" FAIL_SAFE eyJob29rU3BlY2lmaWNPdXRwdXQiOnsiaG9va0V2ZW50TmFtZSI6IlByZVRvb2xVc2UiLCJwZXJtaXNzaW9uRGVjaXNpb24iOiJkZW55IiwicGVybWlzc2lvbkRlY2lzaW9uUmVhc29uIjoiRkFJTF9TQUZFIGRlZmF1bHQgYmxvY2siLCJhZGRpdGlvbmFsQ29udGV4dCI6Ikhvb2sgcnVubmVyIGNyYXNoZWQsIHVzaW5nIHNhZmUgZmFsbGJhY2suIn19 none node \"${PLUGIN_ROOT}/components/ulw-loop/dist/cli.js\" hook pre-tool-use",
						"timeout": 5,
						"statusMessage": "LazyAntigravity(0.2.2): Enforcing Unlimited Goal Budget",
						"failurePolicy": "FAIL_SAFE",
						"fallbackPayload": {
							"hookSpecificOutput": {
								"hookEventName": "PreToolUse",
								"permissionDecision": "deny",
								"permissionDecisionReason": "FAIL_SAFE default block",
								"additionalContext": "Hook runner crashed, using safe fallback."
							}
						}
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "^(apply_patch|write|Write|edit|Edit|multi_edit|multiedit|MultiEdit)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/comment-checker/dist/cli.js\" hook post-tool-use",
						"timeout": 30,
						"statusMessage": "LazyAntigravity(0.2.2): Checking Comments"
					},
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/lsp/dist/cli.js\" hook post-tool-use",
						"timeout": 60,
						"statusMessage": "LazyAntigravity(0.2.2): Checking LSP Diagnostics"
					}
				]
			},
			{
				"matcher": "^apply_patch$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/rules/dist/cli.js\" hook post-tool-use",
						"timeout": 10,
						"statusMessage": "LazyAntigravity(0.2.2): Matching Project Rules"
					}
				]
			}
		],
		"PostCompact": [
			{
				"matcher": "manual|auto",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/git-bash/dist/cli.js\" hook post-compact",
						"timeout": 5,
						"statusMessage": "LazyAntigravity(0.2.2): Resetting Git Bash Mcp Reminder"
					}
				]
			},
			{
				"matcher": "manual|auto",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/rules/dist/cli.js\" hook post-compact",
						"timeout": 10,
						"statusMessage": "LazyAntigravity(0.2.2): Resetting Project Rule Cache"
					}
				]
			},
			{
				"matcher": "manual|auto",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/lsp/dist/cli.js\" hook post-compact",
						"timeout": 5,
						"statusMessage": "LazyAntigravity(0.2.2): Resetting LSP Diagnostics Cache"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/start-work-continuation/dist/cli.js\" hook stop",
						"timeout": 10,
						"statusMessage": "LazyAntigravity(0.2.2): Checking Start-Work Continuation"
					}
				]
			}
		],
		"SubagentStop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/start-work-continuation/dist/cli.js\" hook subagent-stop",
						"timeout": 10,
						"statusMessage": "LazyAntigravity(0.2.2): Checking Start-Work Continuation"
					}
				]
			}
		]
	}
}
