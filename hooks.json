{
  "lazyantigravity": {
    "PreInvocation": [{"type":"command","command":"node ./scripts/antigravity-hook.mjs PreInvocation","timeout":10}],
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [{"type":"command","command":"node ./scripts/antigravity-hook.mjs PreToolUse","timeout":10}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [{"type":"command","command":"node ./scripts/antigravity-hook.mjs PostToolUse","timeout":10}]
      }
    ],
    "Stop": [{"type":"command","command":"node ./scripts/antigravity-hook.mjs Stop","timeout":10}]
  }
}
